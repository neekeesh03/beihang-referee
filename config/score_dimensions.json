{
  "anchors": {
    "10": "exceptional; compelling support, essentially no substantive concern",
    "9": "excellent; very strong with only minor limitations",
    "8": "strong; clear merit with limited correctable weaknesses",
    "7": "good; meaningful contribution but several important limitations",
    "6": "promising; substantial revision needed",
    "5": "mixed; important strengths and weaknesses",
    "4": "serious limitations weaken central conclusions",
    "3": "major scientific/conceptual problems",
    "2": "fundamental deficiencies dominate",
    "1": "unsupported or uninterpretable in current form",
    "N/A": "not applicable"
  },
  "dimensions": [
    "Journal/venue scope fit (post-calibration only)",
    "Importance of research problem",
    "Research-question precision",
    "Scientific significance",
    "Timeliness/relevance",
    "Literature coverage",
    "Literature balance",
    "Literature currency",
    "Nearest-prior-art identification",
    "Field-trend awareness",
    "Problem novelty",
    "Construct/phenomenon novelty",
    "Theoretical novelty",
    "Mechanistic novelty",
    "Methodological novelty",
    "Empirical/data/context novelty",
    "Predictive novelty",
    "Evidence for novelty claims",
    "Construct-definition quality",
    "Construct distinctiveness",
    "Internal theoretical consistency",
    "Mechanistic specificity",
    "Boundary-condition specification",
    "Assumption transparency",
    "Level/temporal coherence",
    "Parsimony",
    "Falsifiability",
    "Rival-theory engagement",
    "Discriminating prediction quality",
    "Empirical adequacy of theory",
    "Design-question alignment",
    "Sampling/population adequacy",
    "Measurement validity",
    "Measurement reliability",
    "Causal identification/confounding control",
    "Statistical rigor",
    "Effect-size/uncertainty reporting",
    "Multiplicity/analytical-flexibility control",
    "Model specification",
    "Model validation",
    "Baseline/comparator fairness",
    "Robustness/sensitivity",
    "Replication/generalizability",
    "Results consistency",
    "Claim\u2013evidence alignment",
    "Reproducibility/transparency",
    "Ethics/research-integrity reporting",
    "Reporting-guideline compliance",
    "Writing/organization/presentation",
    "Overall scientific credibility / claim readiness"
  ],
  "rules": {
    "gate_first": true,
    "global_mean_default": false,
    "confidence_required_for_each_score": true,
    "venue_fit_only_after_journal_calibration": true,
    "one_point_differences_are_not_precise_measurements": true
  }
}
